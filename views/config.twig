{% extends 'admin.base' %}

{% block title %}{{ trans('CampusStatus::campus-status.plugin-title') }} - {{ trans('CampusStatus::campus-status.config.title') }}{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-6">
    {{ form|raw }}
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-12">
    <div class="card card-info">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.config.user-list.title') }}</h3>
      </div>
      <div class="card-body">
        <form method="get" class="mb-0">
          <div class="d-flex flex-wrap align-items-center">
            <div class="input-group mr-sm-2 mb-2 mb-sm-0" style="max-width: 400px; flex: 1 1 250px;">
              <input type="text" name="search" class="form-control"
                     placeholder="{{ trans('CampusStatus::campus-status.config.user-list.search-placeholder') }}"
                     value="{{ search|default('') }}">
              <div class="input-group-append">
                <button class="btn btn-primary" type="submit">
                  <i class="fas fa-search"></i>
                </button>
                {% if search|default('') or status_filter|default('') %}
                <a href="{{ app.request.pathInfo }}" class="btn btn-secondary">
                  <i class="fas fa-times"></i>
                </a>
                {% endif %}
              </div>
            </div>
            <div class="btn-group mb-2 mb-sm-0" role="group">
              <a href="{{ app.request.pathInfo }}?search={{ search|default('') }}&status="
                 class="btn btn-sm {% if not status_filter|default('') %}btn-primary{% else %}btn-outline-primary{% endif %}">
                {{ trans('CampusStatus::campus-status.config.user-list.filter-all') }}
              </a>
              <a href="{{ app.request.pathInfo }}?search={{ search|default('') }}&status=on_campus"
                 class="btn btn-sm {% if status_filter|default('') == 'on_campus' %}btn-success{% else %}btn-outline-success{% endif %}">
                {{ trans('CampusStatus::campus-status.config.user-list.on-campus') }}
              </a>
              <a href="{{ app.request.pathInfo }}?search={{ search|default('') }}&status=off_campus"
                 class="btn btn-sm {% if status_filter|default('') == 'off_campus' %}btn-warning{% else %}btn-outline-warning{% endif %}">
                {{ trans('CampusStatus::campus-status.config.user-list.off-campus') }}
              </a>
              <a href="{{ app.request.pathInfo }}?search={{ search|default('') }}&status=unverified"
                 class="btn btn-sm {% if status_filter|default('') == 'unverified' %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
                {{ trans('CampusStatus::campus-status.config.user-list.unverified') }}
              </a>
            </div>
            <button id="btn-batch-verify" class="btn btn-sm btn-info ml-sm-2 mb-2 mb-sm-0">
              <i class="fas fa-bolt"></i>
              {{ trans('CampusStatus::campus-status.config.user-list.batch-verify') }}
            </button>
          </div>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table table-striped text-nowrap">
          <thead>
            <tr>
              <th>UID</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.nickname') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.email') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.status') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.verified-at') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.expires-at') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.ip') }}</th>
              <th>{{ trans('CampusStatus::campus-status.config.user-list.action') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in userStatuses %}
            <tr>
              <td>{{ item.uid }}</td>
              <td>{{ item.nickname }}</td>
              <td>{{ item.email }}</td>
              <td>
                {% if not item.has_record %}
                  <span class="badge badge-secondary">{{ trans('CampusStatus::campus-status.config.user-list.unverified') }}</span>
                {% elseif item.on_campus %}
                  <span class="badge badge-success">{{ trans('CampusStatus::campus-status.config.user-list.on-campus') }}</span>
                {% else %}
                  <span class="badge badge-warning">{{ trans('CampusStatus::campus-status.config.user-list.off-campus') }}</span>
                {% endif %}
              </td>
              <td>
                {% if item.has_record and item.record.verified_at %}
                  {{ item.record.verified_at.format('Y-m-d H:i') }}
                {% else %}
                  <span class="text-muted">{{ trans('CampusStatus::campus-status.config.user-list.never') }}</span>
                {% endif %}
              </td>
              <td>
                {% if item.has_record and item.record.expires_at %}
                  {{ item.record.expires_at.format('Y-m-d H:i') }}
                {% else %}
                  -
                {% endif %}
              </td>
              <td>
                {% if item.has_record and item.record.ip %}
                  <code>{{ item.record.ip }}</code>
                {% else %}
                  -
                {% endif %}
              </td>
              <td>
                {% if item.on_campus %}
                <button class="btn btn-sm btn-outline-warning btn-revoke"
                        data-uid="{{ item.uid }}"
                        data-nickname="{{ item.nickname }}">
                  <i class="fas fa-times"></i>
                  {{ trans('CampusStatus::campus-status.config.user-list.revoke') }}
                </button>
                {% else %}
                <button class="btn btn-sm btn-outline-primary btn-manual-verify"
                        data-uid="{{ item.uid }}"
                        data-nickname="{{ item.nickname }}">
                  <i class="fas fa-check"></i>
                  {{ trans('CampusStatus::campus-status.config.user-list.manual-verify') }}
                </button>
                {% endif %}
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="8" class="text-center text-muted py-3">{{ trans('CampusStatus::campus-status.config.user-list.unverified') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if users|default(null) %}
      <div class="card-footer">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
          <div class="text-muted mb-2 mb-sm-0">
            {{ trans('CampusStatus::campus-status.config.user-list.showing', {from: users.firstItem()|default(0), to: users.lastItem()|default(0), total: users.count()}) }}
          </div>
          <div>
            {{ users.links()|raw }}
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}

{% block before_foot %}
<script>
(function() {
  var csrfToken = '{{ csrf_token() }}';

  var batchBtn = document.getElementById('btn-batch-verify');
  if (batchBtn) {
    batchBtn.addEventListener('click', function() {
      if (!confirm('{{ trans("CampusStatus::campus-status.config.user-list.batch-verify-confirm") }}')) {
        return;
      }

      batchBtn.disabled = true;
      var originalHtml = batchBtn.innerHTML;
      batchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      fetch('/admin/campus-status/batch-verify', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        alert(data.message);
        location.reload();
      })
      .catch(function() {
        alert('{{ trans("CampusStatus::campus-status.config.user-list.batch-verify-fail") }}');
        batchBtn.disabled = false;
        batchBtn.innerHTML = originalHtml;
      });
    });
  }

  document.querySelectorAll('.btn-manual-verify').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var uid = this.dataset.uid;
      var nickname = this.dataset.nickname;

      if (!confirm('{{ trans("CampusStatus::campus-status.config.user-list.manual-verify-confirm", {name: "__NAME__"}) }}'.replace('__NAME__', nickname))) {
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      fetch('/admin/campus-status/manual-verify/' + uid, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.code === 0) {
          location.reload();
        } else {
          alert(data.message);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> {{ trans("CampusStatus::campus-status.config.user-list.manual-verify") }}';
        }
      })
      .catch(function() {
        alert('{{ trans("CampusStatus::campus-status.config.user-list.manual-verify-fail") }}');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> {{ trans("CampusStatus::campus-status.config.user-list.manual-verify") }}';
      });
    });
  });

  document.querySelectorAll('.btn-revoke').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var uid = this.dataset.uid;
      var nickname = this.dataset.nickname;

      if (!confirm('{{ trans("CampusStatus::campus-status.config.user-list.revoke-confirm", {name: "__NAME__"}) }}'.replace('__NAME__', nickname))) {
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      fetch('/admin/campus-status/revoke/' + uid, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.code === 0) {
          location.reload();
        } else {
          alert(data.message);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-times"></i> {{ trans("CampusStatus::campus-status.config.user-list.revoke") }}';
        }
      })
      .catch(function() {
        alert('{{ trans("CampusStatus::campus-status.config.user-list.revoke-fail") }}');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-times"></i> {{ trans("CampusStatus::campus-status.config.user-list.revoke") }}';
      });
    });
  });
})();
</script>
{% endblock %}
