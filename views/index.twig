{% extends 'user.base' %}

{% block title %}{{ trans('CampusStatus::campus-status.page.title') }}{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-8 col-lg-6">
    <div class="card card-primary">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.current-status') }}</h3>
      </div>
      <div class="card-body">
        {% if status == 'on_campus' %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
          <div>
            <h5 class="mb-0 text-success">{{ trans('CampusStatus::campus-status.page.on-campus') }}</h5>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.verified-at', {time: verified_at.format('Y-m-d H:i')}) }}</p>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.valid-until', {date: valid_until.format('Y-m-d H:i')}) }}</p>
          </div>
        </div>
        {% elseif status == 'off_campus' %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-exclamation-circle fa-2x text-warning mr-3"></i>
          <div>
            <h5 class="mb-0 text-warning">{{ trans('CampusStatus::campus-status.page.off-campus') }}</h5>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.expired') }}</p>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.verified-at', {time: verified_at.format('Y-m-d H:i')}) }}</p>
          </div>
        </div>
        {% else %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-minus-circle fa-2x text-secondary mr-3"></i>
          <div>
            <h5 class="mb-0 text-secondary">{{ trans('CampusStatus::campus-status.page.not-verified') }}</h5>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="card card-default">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.ip-check') }}</h3>
      </div>
      <div class="card-body">
        <p class="mb-3">
          <code>{{ current_ip }}</code>
        </p>
        {% if is_on_campus_ip %}
        <div class="alert alert-success mb-0">
          <i class="fas fa-wifi mr-1"></i>
          {{ trans('CampusStatus::campus-status.page.ip-on-campus') }}
        </div>
        {% else %}
        <div class="alert alert-secondary mb-0">
          <i class="fas fa-times-circle mr-1"></i>
          {{ trans('CampusStatus::campus-status.page.ip-off-campus') }}
          <br>
          <small>{{ trans('CampusStatus::campus-status.page.ip-off-campus-vpn', {url: 'https://sslvpn.ecust.edu.cn/portal/?redirect_uri=https%3A%2F%2Fmcskin-ecustvr-top-s.sslvpn.ecust.edu.cn%3A8118%2Fuser%2Fcampus-status#!/login'})|raw }}</small>
        </div>
        {% endif %}
      </div>
      <div class="card-footer">
        {% if is_on_campus_ip %}
          {% if status == 'on_campus' %}
          <button id="btn-verify" class="btn btn-primary">
            <i class="fas fa-sync-alt"></i>
            {{ trans('CampusStatus::campus-status.page.renew-button') }}
          </button>
          {% else %}
          <button id="btn-verify" class="btn btn-primary">
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.verify-button') }}
          </button>
          {% endif %}
        {% else %}
          {% if status == 'on_campus' %}
          <button class="btn btn-secondary" disabled>
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.already-verified') }}
          </button>
          {% else %}
          <button class="btn btn-secondary" disabled>
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.verify-button') }}
          </button>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="card card-info">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.email-verify-title') }}</h3>
      </div>
      <div class="card-body">
        <p class="mb-2">{{ trans('CampusStatus::campus-status.page.email-verify-description') }}</p>
        <p class="mb-3"><code>{{ user_email }}</code></p>
        {% if email_verify_result.valid %}
        {% if email_verify_result.type == 'graduate' %}
        <div class="alert alert-info mb-2">
          <i class="fas fa-info-circle mr-1"></i>
          {{ trans('CampusStatus::campus-status.page.email-verify-graduate-note') }}
        </div>
        {% endif %}
        <button id="btn-email-verify" class="btn btn-info">
          <i class="fas fa-id-card"></i>
          {{ trans('CampusStatus::campus-status.page.email-verify-button') }}
        </button>
        {% else %}
        <div class="alert alert-secondary mb-0">
          <i class="fas fa-times-circle mr-1"></i>
          {{ email_verify_result.message }}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-md-4 col-lg-6">
    {% if benefits_html %}
    <div class="card card-success">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.benefits-title') }}</h3>
      </div>
      <div class="card-body benefits-content">
        {{ benefits_html|raw }}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block before_foot %}
<style>
.benefits-content h1 { font-size: 1.5rem; }
.benefits-content h2 { font-size: 1.3rem; }
.benefits-content h3 { font-size: 1.15rem; }
.benefits-content ul { padding-left: 1.5rem; }
.benefits-content ol { padding-left: 1.5rem; }
.benefits-content a { color: #007bff; }
.benefits-content a:hover { text-decoration: underline; }
.benefits-content code { background: #f4f4f5; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
.benefits-content pre { background: #f4f4f5; padding: 0.8rem; border-radius: 5px; overflow-x: auto; }
.benefits-content pre code { background: none; padding: 0; }
.benefits-content blockquote { border-left: 4px solid #007bff; padding-left: 1rem; color: #6c757d; margin-left: 0; }
.benefits-content table { width: 100%; border-collapse: collapse; margin-bottom: 0.5rem; }
.benefits-content th, .benefits-content td { border: 1px solid #dee2e6; padding: 0.4rem 0.6rem; }
.benefits-content th { background: #f4f4f5; }
</style>
<script>
(function() {
  var csrfToken = '{{ csrf_token() }}';

  var btn = document.getElementById('btn-verify');
  if (btn) {
    btn.addEventListener('click', function() {
      btn.disabled = true;
      var originalHtml = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ...';

      fetch('/user/campus-status/verify', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.code === 0) {
          alert(data.message);
          location.reload();
        } else {
          alert(data.message);
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      })
      .catch(function() {
        alert('{{ trans("CampusStatus::campus-status.page.verify-fail") }}');
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      });
    });
  }

  var emailBtn = document.getElementById('btn-email-verify');
  if (emailBtn) {
    emailBtn.addEventListener('click', function() {
      emailBtn.disabled = true;
      var originalHtml = emailBtn.innerHTML;
      emailBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ...';

      fetch('/user/campus-status/verify-by-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin'
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.code === 0) {
          alert(data.message);
          location.reload();
        } else {
          alert(data.message);
          emailBtn.disabled = false;
          emailBtn.innerHTML = originalHtml;
        }
      })
      .catch(function() {
        alert('{{ trans("CampusStatus::campus-status.page.email-verify-fail") }}');
        emailBtn.disabled = false;
        emailBtn.innerHTML = originalHtml;
      });
    });
  }
})();
</script>
{% endblock %}
