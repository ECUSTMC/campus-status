{% extends 'user.base' %}

{% block title %}{{ trans('CampusStatus::campus-status.page.title') }}{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-8 col-lg-6">
    <div class="card card-primary">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.current-status') }}</h3>
      </div>
      <div class="card-body">
        {% if status == 'on_campus' %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
          <div>
            <h5 class="mb-0 text-success">{{ trans('CampusStatus::campus-status.page.on-campus') }}</h5>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.verified-at', {time: verified_at.format('Y-m-d H:i')}) }}</p>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.valid-until', {date: valid_until.format('Y-m-d')}) }}</p>
          </div>
        </div>
        {% elseif status == 'off_campus' %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-exclamation-circle fa-2x text-warning mr-3"></i>
          <div>
            <h5 class="mb-0 text-warning">{{ trans('CampusStatus::campus-status.page.off-campus') }}</h5>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.expired') }}</p>
            <p class="text-muted mb-0">{{ trans('CampusStatus::campus-status.page.verified-at', {time: verified_at.format('Y-m-d H:i')}) }}</p>
          </div>
        </div>
        {% else %}
        <div class="d-flex align-items-center mb-3">
          <i class="fas fa-minus-circle fa-2x text-secondary mr-3"></i>
          <div>
            <h5 class="mb-0 text-secondary">{{ trans('CampusStatus::campus-status.page.not-verified') }}</h5>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="card card-default">
      <div class="card-header">
        <h3 class="card-title">{{ trans('CampusStatus::campus-status.page.ip-check') }}</h3>
      </div>
      <div class="card-body">
        {% if is_on_campus_ip %}
        <div class="alert alert-success mb-0">
          <i class="fas fa-wifi mr-1"></i>
          {{ trans('CampusStatus::campus-status.page.ip-on-campus') }}
        </div>
        {% else %}
        <div class="alert alert-secondary mb-0">
          <i class="fas fa-wifi-slash mr-1"></i>
          {{ trans('CampusStatus::campus-status.page.ip-off-campus') }}
        </div>
        {% endif %}
      </div>
      <div class="card-footer">
        {% if is_on_campus_ip %}
          {% if status == 'on_campus' %}
          <button id="btn-verify" class="btn btn-primary">
            <i class="fas fa-sync-alt"></i>
            {{ trans('CampusStatus::campus-status.page.renew-button') }}
          </button>
          {% else %}
          <button id="btn-verify" class="btn btn-primary">
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.verify-button') }}
          </button>
          {% endif %}
        {% else %}
          {% if status == 'on_campus' %}
          <button class="btn btn-secondary" disabled>
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.already-verified') }}
          </button>
          {% else %}
          <button class="btn btn-secondary" disabled>
            <i class="fas fa-check"></i>
            {{ trans('CampusStatus::campus-status.page.verify-button') }}
          </button>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block before_foot %}
<script>
(function() {
  var btn = document.getElementById('btn-verify');
  if (!btn) return;

  btn.addEventListener('click', function() {
    btn.disabled = true;
    var originalHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ...';

    fetch('/user/campus-status/verify', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-TOKEN': '{{ csrf_token() }}',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(function(resp) { return resp.json(); })
    .then(function(data) {
      if (data.code === 0) {
        alert(data.message);
        location.reload();
      } else {
        alert(data.message);
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    })
    .catch(function() {
      alert('{{ trans("CampusStatus::campus-status.page.verify-fail") }}');
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    });
  });
})();
</script>
{% endblock %}
